{
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python"
    },
    {
      "src": "staticfiles/**",
      "use": "@vercel/static"
    },
    {
      "src": "media/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/"
    },
    {
      "src": "/media/(.*)",
      "dest": "/media/"
    },
    {
      "src": "/(.*)",
      "dest": "index.py"
    }
  ]
}